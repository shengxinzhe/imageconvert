NEXT_PUBLIC_SITE_URL=https://heicsave.com

# Ezoic (set ENABLED=true on Vercel production for incubator / ad integration)
NEXT_PUBLIC_EZOIC_ENABLED=false
# Placeholder IDs from Ezoic dashboard → Ad Positions (defaults 101 sidebar, 102 in-content)
NEXT_PUBLIC_EZOIC_PLACEHOLDER_SIDEBAR=101
NEXT_PUBLIC_EZOIC_PLACEHOLDER_IN_CONTENT=102

# Optional: Plausible domain when you add the script
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=heicsave.com
