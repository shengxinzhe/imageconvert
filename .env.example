NEXT_PUBLIC_SITE_URL=https://heicsave.com

# Bing Webmaster verification (meta tag method — paste content from Bing dashboard)
# BING_MSVALIDATE=YOUR_BING_VERIFICATION_CODE
# Or drop BingSiteAuth.xml into public/ (XML file method)

# Google AdSense (application + ads)
# 1. Create account at https://www.google.com/adsense/
# 2. Add site heicsave.com and paste verification — set CLIENT_ID below on Vercel
# 3. After approval: copy ads.txt line into public/ads.txt, add ad unit slot IDs
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-1564555416568365
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=

# Disable Ezoic on Vercel (use Google only): do not set NEXT_PUBLIC_EZOIC_ENABLED=true

# Google Analytics 4 — pageviews after cookie Accept (default ID baked in; override if needed)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-3EJJVL98R0

# Optional: Plausible domain when you add the script
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=heicsave.com
